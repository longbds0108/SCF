# ---- Public (bundled into the client — never put secrets here) ----

# Active network: "testnet" | "mainnet"
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Horizon endpoints
NEXT_PUBLIC_HORIZON_URL_TESTNET=https://horizon-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL_MAINNET=https://horizon.stellar.org

# Soroban RPC endpoints (mainnet usually requires a paid provider — Blockdaemon, Validation Cloud, etc.)
NEXT_PUBLIC_SOROBAN_RPC_URL_TESTNET=https://soroban-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL_MAINNET=

# Network passphrases are NOT env vars — they're sourced directly from the SDK's
# Networks.TESTNET / Networks.PUBLIC constants in src/lib/network.ts, on purpose.

# USDC issuer accounts — defaults are Circle's official Stellar addresses (see
# developers.circle.com/stablecoins/usdc-contract-addresses). Only override this if you're
# pointing at a different/self-issued test asset — re-verify before changing either value.
NEXT_PUBLIC_USDC_ISSUER_TESTNET=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_USDC_ISSUER_MAINNET=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# ---- Server-only (never prefix with NEXT_PUBLIC_) ----

# WebAuthn relying party — must match the deployed domain exactly in production
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME="XLMFlow"
WEBAUTHN_ORIGIN=http://localhost:3000

# Session signing secret (generate with: openssl rand -base64 32)
SESSION_SECRET=

# Fee-bump / sponsorship relayer account secret key — server-only, never expose
RELAYER_SPONSOR_SECRET_KEY=
